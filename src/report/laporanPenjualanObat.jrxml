	<property name="ireport.zoom" value="1.3310000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[SELECT 
    dp.id_penjualan, 
    p.nama, 
    CONCAT(dp.id_obat, ' - ', o.nama_obat) AS obat, 
    dp.harga, 
    dp.jumlah, 
    dp.subtotal
FROM 
    detail_penjualan dp
JOIN 
    obat o ON dp.id_obat = o.id_obat
JOIN 
    penjualan pj ON dp.id_penjualan = pj.id_penjualan
JOIN 
    pasien p ON pj.id_pasien = p.id_pasien order by dp.id_penjualan asc]]>
	</queryString>
	<field name="id_penjualan" class="java.lang.Integer">
