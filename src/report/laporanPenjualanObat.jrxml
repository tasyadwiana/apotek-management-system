		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="Total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
	</variable>
	<variable name="tanggal" class="java.lang.String"/>
