	<property name="ireport.y" value="70"/>
	<queryString>
		<![CDATA[SELECT dp.id_pembelian, 
       s.nama_supplier, 
       CONCAT(o.id_obat, ' - ', o.nama_obat) AS nama_obat,
       dp.jumlah, 
       dp.harga, 
       dp.subtotal
FROM detail_pembelian dp
JOIN pembelian p ON dp.id_pembelian = p.id_pembelian
JOIN supplier s ON p.id_supplier = s.id_supplier
JOIN obat o ON dp.id_obat = o.id_obat
ORDER BY dp.id_pembelian ASC]]>
	</queryString>
	<field name="id_pembelian" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_supplier" class="java.lang.String">
